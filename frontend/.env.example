# Copie para .env.local e preencha. Nunca versione valores reais.

# ID do cliente OAuth do Google (tipo "Aplicativo da Web"). Vazio = o botão "Entrar com Google" não aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Domínios de e-mail aceitos no login com Google, separados por vírgula (hipótese da equipe).
NEXT_PUBLIC_GOOGLE_ALLOWED_DOMAINS=undb.edu.br
