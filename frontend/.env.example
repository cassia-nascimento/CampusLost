# Copie para .env.local e preencha. Nunca versione valores reais.

# ID do cliente OAuth do Google (tipo "Aplicativo da Web"). Vazio = o botão "Entrar com Google" não aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Domínios de e-mail aceitos no login com Google, separados por vírgula (hipótese da equipe).
NEXT_PUBLIC_GOOGLE_ALLOWED_DOMAINS=undb.edu.br

# Endereço da API REST (FastAPI), sem barra final. Vazio = modo de demonstração com dados de exemplo no navegador (mock).
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas no código em tempo de BUILD; mudar o valor exige novo build/deploy
# (na Vercel, novo deploy). A API precisa liberar a origem do site em CORS_ORIGINS.
NEXT_PUBLIC_API_URL=
# Exemplo local: NEXT_PUBLIC_API_URL=http://localhost:8000
