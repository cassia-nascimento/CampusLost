# Copie para .env.local e preencha. Nunca versione valores reais.

# ID do cliente OAuth do Google (tipo "Aplicativo da Web"). Vazio = o botão "Entrar com Google" não aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Domínios de e-mail aceitos no login com Google, separados por vírgula (hipótese da equipe).
NEXT_PUBLIC_GOOGLE_ALLOWED_DOMAINS=undb.edu.br

# Endereço da API REST (FastAPI), sem barra final. Vazio = modo de demonstração com dados de exemplo no navegador (mock).
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas no código em tempo de BUILD; mudar o valor exige novo build/deploy
# (na Vercel, novo deploy). A API precisa liberar a origem do site em CORS_ORIGINS.
NEXT_PUBLIC_API_URL=
# Exemplo local: NEXT_PUBLIC_API_URL=http://localhost:8000

# Chave PÚBLICA (site key) do Cloudflare Turnstile. Vazio = sem captcha (login, cadastro, esqueci-senha e reenvio funcionam como hoje).
# Defina só se a API tiver o captcha ativo (TURNSTILE_SECRET_KEY). Chave de teste da Cloudflare que sempre passa: 1x00000000000000000000AA
# Embutida no código em tempo de BUILD (novo deploy ao mudar).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Endereço INTERNO da API, usado só pelo servidor do Next (variável de servidor, não NEXT_PUBLIC). Vale quando
# NEXT_PUBLIC_API_URL está definida: o Next repassa `/backend/*` (mesma origem) para `${API_INTERNAL_URL}/*`.
# Vazio = http://localhost:8000. Lida ao iniciar o servidor (next dev/start) e ao compilar.
API_INTERNAL_URL=
