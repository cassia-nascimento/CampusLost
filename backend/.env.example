# Copie para .env e ajuste. NUNCA versione o .env com valores reais.

# development | production | test
ENV=development

# Obrigatória em produção (mínimo 32 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Minutos de validade do token de sessão (padrão 480)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Padrão: sqlite:///<backend>/data/campuslost.db
DATABASE_URL=
# Pasta das fotos enviadas (padrão: <backend>/uploads)
UPLOADS_DIR=

# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Rotas /demo/* e seed automático. Padrão: true em desenvolvimento, false com ENV=production
DEMO_MODE=

# Login com Google institucional (P30)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=undb.edu.br

# Fuso usado nas datas de calendário (padrão America/Fortaleza)
APP_TIMEZONE=America/Fortaleza

# Limite de login (persistido no banco, por IP + e-mail): falhas até bloquear e duração do 1º bloqueio em segundos
# (dobra a cada novo bloqueio, até 1 h)
LOGIN_RATE_LIMIT=10
RETURN_CODE_MAX_ATTEMPTS=5
RETURN_CODE_LOCK_SECONDS=900
RETURN_CODE_VERIFY_TTL_SECONDS=900
LOGIN_RATE_WINDOW_SECONDS=60

# --- E-mail (verificação de e-mail e recuperação de senha) ---
# console = imprime o link no log do servidor (só desenvolvimento); smtp = envia de verdade (obrigatório em produção)
MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Segredo: nunca versione o .env com valor real. Usa STARTTLS na porta 587.
SMTP_PASSWORD=
# Remetente, ex.: CampusLost <nao-responda@seu-dominio.com.br>
SMTP_FROM=
# URL do frontend, usada nos links enviados por e-mail (/verificar-email?token=..., /redefinir-senha?token=...)
APP_BASE_URL=http://localhost:3000

# --- Sessões por cookie ---
# Secure nos cookies: vazio = ligado fora de development/test. Use false só em HTTP local fora desses ambientes.
COOKIE_SECURE=
# Vida do cookie de acesso (min) e do refresh rotativo (dias)
COOKIE_ACCESS_MINUTES=15
REFRESH_DAYS=7

# Cloudflare Turnstile (captcha). Vazio = desligado. Com valor, signup/login/forgot/resend exigem turnstileToken.
TURNSTILE_SECRET=
# Opcional: hostnames aceitos na verificação (ex.: seu-site.vercel.app,localhost). Vazio = não confere.
# Em produção não inclua localhost.
TURNSTILE_HOSTNAMES=

# Versão dos termos de uso/política de privacidade gravada no aceite (LGPD)
TERMS_VERSION=2026-10

# Tamanho máximo do corpo da requisição em bytes (padrão 11 MB)
MAX_BODY_BYTES=11534336
# Custo do bcrypt (padrão 12)
BCRYPT_ROUNDS=12

# --- Administração (B2) ---
# 2FA obrigatório para administração em /admin/*. Vazio = exigido, exceto com DEMO_MODE=true. true/false força.
ADMIN_REQUIRE_2FA=
# Validade do convite de administração (horas)
INVITE_TOKEN_HOURS=48
# Destino do backup (python -m app.backup). Vazio = data/backups
BACKUP_DIR=

# Path do cookie de refresh. Padrão /auth. Atrás de proxy same-origin do Next (/backend/...) use /
COOKIE_REFRESH_PATH=/
