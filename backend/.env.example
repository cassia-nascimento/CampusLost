# Copie para .env e ajuste. NUNCA versione o .env com valores reais.

# development | production | test
ENV=development

# Obrigatória em produção (mínimo 32 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Minutos de validade do token de sessão (padrão 480)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Padrão: sqlite:///<backend>/data/campuslost.db
DATABASE_URL=
# Pasta das fotos enviadas (padrão: <backend>/uploads)
UPLOADS_DIR=

# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Rotas /demo/* e seed automático. Padrão: true em desenvolvimento, false com ENV=production
DEMO_MODE=

# Login com Google institucional (P30)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=undb.edu.br

# Fuso usado nas datas de calendário (padrão America/Fortaleza)
APP_TIMEZONE=America/Fortaleza

# Limite de login: tentativas por janela (IP + e-mail)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# Tamanho máximo do corpo da requisição em bytes (padrão 11 MB)
MAX_BODY_BYTES=11534336
# Custo do bcrypt (padrão 12)
BCRYPT_ROUNDS=12
